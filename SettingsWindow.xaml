<Window x:Class="PetdexPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宠物设置" Width="354" Height="505"
        MinHeight="300" MaxHeight="505"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" MouseLeftButtonDown="Window_MouseDown">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C3CAE0" CornerRadius="2"
                                                        Margin="0,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F4F6FB"/>
            <Setter Property="BorderBrush" Value="#D8DEF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#203170"/>
            <Setter Property="CaretBrush" Value="#536BA9"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Foreground" Value="#33406B"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#536BA9"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7A86AD"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="White" BorderBrush="#E2E6F2"
            BorderThickness="1" Margin="12" ClipToBounds="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,14,24,0">
                <TextBlock Text="宠物设置" FontSize="17" FontWeight="Bold"
                           Foreground="#203170" VerticalAlignment="Center"/>
                <Button Width="28" Height="28" HorizontalAlignment="Right"
                        Click="Close_Click" Content="✕" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#98A2C0" FontSize="13"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="20,4,9,4">
                <StackPanel Margin="6,0,8,4">
                    <TextBlock x:Name="SizeText" Text="尺寸:100%" Style="{StaticResource Value}"/>
                    <Slider x:Name="ScaleSlider" Minimum="0.1" Maximum="1.3"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            ValueChanged="ScaleSlider_ValueChanged"/>

                    <TextBlock Text="动作开关" Style="{StaticResource Section}"/>
                    <StackPanel x:Name="ActionList"/>

                    <TextBlock x:Name="ActionDurText" Text="动作播放时长:3 秒" Style="{StaticResource Value}"/>
                    <Slider x:Name="ActionDurSlider" Minimum="1" Maximum="10"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="ActionDur_Changed"/>

                    <TextBlock Text="气泡内容(每行一条)" Style="{StaticResource Section}"/>
                    <TextBox x:Name="BubblesBox" AcceptsReturn="True" Height="86"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock x:Name="BubbleSizeText" Text="气泡大小:100%" Style="{StaticResource Value}"/>
                    <Slider x:Name="BubbleSizeSlider" Minimum="0.5" Maximum="2"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="BubblePref_Changed"/>

                    <TextBlock x:Name="FontText" Text="文字大小:56" Style="{StaticResource Value}"/>
                    <Slider x:Name="FontSlider" Minimum="50" Maximum="300"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="BubblePref_Changed"/>

                    <TextBlock x:Name="DurText" Text="气泡显示:3.5 秒" Style="{StaticResource Value}"/>
                    <Slider x:Name="DurSlider" Minimum="1" Maximum="15"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="BubblePref_Changed"/>

                    <TextBlock x:Name="FreqText" Text="气泡频率:30 秒" Style="{StaticResource Value}"/>
                    <Slider x:Name="FreqSlider" Minimum="30" Maximum="600"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="BubblePref_Changed"/>

                    <CheckBox x:Name="CountdownCheck" Content="下班倒计时气泡" Margin="0,16,0,4"
                              Checked="Countdown_Changed" Unchecked="Countdown_Changed"/>
                    <CheckBox x:Name="OffWorkPinnedCheck" Content="倒计时气泡常驻显示"
                              Margin="0,4,0,4"
                              Checked="OffWorkPinned_Changed" Unchecked="OffWorkPinned_Changed"/>

                    <TextBlock Text="下班时间(HH:mm)" Style="{StaticResource Value}"/>
                    <TextBox x:Name="OffWorkTimeBox" TextChanged="Countdown_Changed"/>
                    <TextBlock Text="倒计时文字(用 {time} 占位)" Style="{StaticResource Value}"/>
                    <TextBox x:Name="CountdownTextBox" TextChanged="Countdown_Changed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,8,24,16">
                <Button x:Name="SaveBtn" Content="保存" Width="88" Height="30" Click="Save_Click"
                        Cursor="Hand" Background="#536BA9" Foreground="White"
                        BorderThickness="0" FontSize="13"/>
                <Button Content="关闭" Width="88" Height="30" Margin="12,0,0,0" Click="Close_Click"
                        Cursor="Hand" Background="#EEF1F8" Foreground="#33406B"
                        BorderThickness="0" FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
